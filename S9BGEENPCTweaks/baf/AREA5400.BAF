IF
	!Dead("DORN")
	!InParty("DORN")
	Global("DORNExists","GLOBAL",0)
	HasDLC("DORN")
THEN
	RESPONSE #100
		SetGlobal("DORNExists","GLOBAL",1)
		CreateCreature("%s9cre_DORN%",[2747.311],S) // Dorn
		ActionOverride("DORN",MakeGlobal())
		ActionOverride("DORN",ChangeAIScript("%DORN_BCS%",OVERRIDE))
		
END
