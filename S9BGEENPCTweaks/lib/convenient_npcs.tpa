// Convenient NPCs (components 30 and 31). s9_voice = 1 when the AI voiceovers were chosen.

ACTION_IF GAME_IS ~bgee eet~ THEN BEGIN	
	/* Alora to start in Gullykin near the door to the winery. */
	// code borrowed from BG1NPC authored and coded by tons of dedicated people from all walks of life 
    COPY_EXISTING ~baldur.gam~ ~override~
      READ_LONG 0x30 non_joined_npcs_off
      READ_LONG 0x34 non_joined_npcs_count
      FOR (i = 0; i < non_joined_npcs_count; i+=1) BEGIN
        SET cre_offset = non_joined_npcs_off + i * 0x160
        READ_ASCII 0xc + cre_offset ~CREName~
        PATCH_IF (~%CREName%~ STR_EQ ~%s9cre_ALORA%~) BEGIN
			WRITE_ASCIIE cre_offset + 0x18 ~%Gullykin%~ #8
			WRITE_SHORT cre_offset + 0x20 553
			WRITE_SHORT cre_offset + 0x22 506
        END
      END
      BUT_ONLY_IF_IT_CHANGES
	  
	ACTION_IF (s9_voice = 1) BEGIN
		COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/dialogue/x#aloramoves.d~
			USING ~%MOD_FOLDER%/translations/%LANGUAGE%/X#ALORAN.TRA~ ~%MOD_FOLDER%/translations/%LANGUAGE%/X#ALORAN_voice.tra~
	END ELSE BEGIN
		COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/dialogue/x#aloramoves.d~
			USING ~%MOD_FOLDER%/translations/%LANGUAGE%/X#ALORAN.TRA~
	END

    COPY_EXISTING ~%HallofWonders_BCS%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
		LPF s9_replace STR_VAR find = ~!InParty("alora")~ repl = ~!InParty("alora") Global("X#AloraDontBeDifficult","GLOBAL",1)~ END
      END
      BUT_ONLY_IF_IT_CHANGES	  

/* Coran to Cloakwood Lodge near the bridge */
	COPY_EXISTING ~baldur.gam~ ~override~
	READ_LONG 0x30 non_joined_npcs_off
	READ_LONG 0x34 non_joined_npcs_count
	FOR (i = 0; i < non_joined_npcs_count; i+=1) BEGIN
		SET cre_offset = non_joined_npcs_off + i * 0x160
		READ_ASCII 0xc + cre_offset ~CREName~
		PATCH_IF (~%CREName%~ STR_EQ ~%s9cre_CORAN%~) BEGIN
			WRITE_ASCIIE cre_offset + 0x18 ~%CloakwoodLodge%~ #8
			WRITE_SHORT cre_offset + 0x20 1857
			WRITE_SHORT cre_offset + 0x22 949
			END
		END
		BUT_ONLY_IF_IT_CHANGES
	//extend Coran's quest timer
	EXTEND_BOTTOM ~%CloakwoodNest%.bcs~ ~%MOD_FOLDER%/baf/corantimer.baf~
	COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/dialogue/coran.d~  

/* Dorn BGEE: Nashkel Mines next to the Cabin */
	EXTEND_BOTTOM ~%NashkelMines%.bcs~ ~%MOD_FOLDER%/baf/AREA5400.baf~ EVALUATE_BUFFER
	COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/dialogue/dorn.d~

	COPY_EXISTING ~%FriendlyArmInn_L1%.bcs~ ~override~
	DECOMPILE_AND_PATCH BEGIN
		LPF s9_replace STR_VAR find = ~Global("DORNExists","GLOBAL",0)~ repl = ~False()~ END
	END BUT_ONLY

/* Dorn SOD: Three Old Kegs and Flaming Fist Camp */	
	ACTION_IF FILE_EXISTS_IN_GAME ~DORN7.cre~ THEN BEGIN
		EXTEND_BOTTOM ~BD0106.bcs~ ~%MOD_FOLDER%/lib/soddorn.baf~
		COPY_EXISTING ~BD2000.bcs~ ~override~
		DECOMPILE_AND_PATCH BEGIN
			LPF s9_replace STR_VAR find = ~Global("bd_dorn_spawn","bd2000",0)~ repl = ~False()~ END
		END BUT_ONLY
		
		COPY_EXISTING ~BD3000.bcs~ ~override~
		DECOMPILE_AND_PATCH BEGIN
			LPF s9_replace STR_VAR find = ~GlobalGT("bd_dorn_join","global",0)~ repl = ~True()~ END
		END BUT_ONLY
	END	
	  
/* Eldoth to Beregost Red Sheaf near Bartender */
	// The Vanishing of Skie Silvershield moves Eldoth to the Friendly Arm Inn. When it is installed,
	// stop that move so he stays at the Red Sheaf; its dialogue and quest still run there (chapters 1-4).
	ACTION_IF (MOD_IS_INSTALLED ~TheVanishingOfSkieSilvershield.tp2~ ~0~ OR FILE_EXISTS_IN_GAME ~l#sss1.are~) BEGIN
		PRINT @607
		EXTEND_TOP ~BALDUR.bcs~ ~%MOD_FOLDER%/baf/eldoth_vanishing.baf~
		// The Vanishing's opening line assumes he is outside the Friendly Arm Inn ("better than what
		// they serve inside"). Point that state at a version that fits the Red Sheaf.
		COPY_EXISTING ~%s9dlg_ELDOTH%.dlg~ ~override~
			READ_LONG 0x08 num_states
			READ_LONG 0x0c states_off
			READ_LONG 0x18 strig_off
			READ_LONG 0x1c num_strig
			SET found = 0
			FOR (i = 0; i < num_states; ++i) BEGIN
				READ_LONG (states_off + i * 16 + 12) trig
				PATCH_IF (trig >= 0 AND trig < num_strig) BEGIN
					READ_LONG (strig_off + trig * 8) t_off
					READ_LONG (strig_off + trig * 8 + 4) t_len
					READ_ASCII t_off trig_text (t_len)
					PATCH_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~L#SSQUEST~ ~%trig_text%~) >= 0 AND INDEX (CASE_INSENSITIVE EXACT_MATCH ~NumTimesTalkedTo(0)~ ~%trig_text%~) >= 0) BEGIN
						WRITE_LONG (states_off + i * 16) RESOLVE_STR_REF (@608)
						SET found = 1
					END
				END
			END
			PATCH_IF (found = 0) BEGIN
				PATCH_WARN @609
			END
		BUT_ONLY
	END
	COPY_EXISTING ~baldur.gam~ ~override~
	READ_LONG 0x30 non_joined_npcs_off
	READ_LONG 0x34 non_joined_npcs_count
	FOR (i = 0; i < non_joined_npcs_count; i+=1) BEGIN
		SET cre_offset = non_joined_npcs_off + i * 0x160
		READ_ASCII 0xc + cre_offset ~CREName~
		PATCH_IF (~%CREName%~ STR_EQ ~%s9cre_ELDOTH%~) BEGIN
			WRITE_ASCIIE cre_offset + 0x18 ~%Beregost_RedSheaf_L1%~ #8
			WRITE_SHORT cre_offset + 0x20 772
			WRITE_SHORT cre_offset + 0x22 300
			END
		END
		BUT_ONLY_IF_IT_CHANGES
	COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/dialogue/eldoth.d~
	
