/* Shar-Teel to South Beregost Road */
	COPY_EXISTING ~baldur.gam~ ~override~
	READ_LONG 0x30 non_joined_npcs_off
	READ_LONG 0x34 non_joined_npcs_count
	FOR (i = 0; i < non_joined_npcs_count; i+=1) BEGIN
		SET cre_offset = non_joined_npcs_off + i * 0x160
		READ_ASCII 0xc + cre_offset ~CREName~
		PATCH_IF (~%CREName%~ STR_EQ ~%s9cre_SHARTE%~) BEGIN
			WRITE_ASCIIE cre_offset + 0x18 ~%SouthBeregostRoad%~ #8
			WRITE_SHORT cre_offset + 0x20 4160
			WRITE_SHORT cre_offset + 0x22 735
			END
		END
	BUT_ONLY_IF_IT_CHANGES	
	
	EXTEND_TOP ~%SouthBeregostRoad%.bcs~ ~%MOD_FOLDER%/baf/sharteel_ee.baf~ EVALUATE_BUFFER
	COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/dialogue/sharte.d~
	
	COPY_EXISTING ~%s9bcs_SHARTEL2%.bcs~ ~override~	
	DECOMPILE_AND_PATCH BEGIN
		LPF s9_replace STR_VAR find = EVAL ~%MutaminsGarden%~ repl = EVAL ~%SouthBeregostRoad%~ END
		END
	BUT_ONLY_IF_IT_CHANGES	
	
	COPY_EXISTING ~%MutaminsGarden%.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
		// kill these highly unlikely triggers
		LPF s9_replace STR_VAR find = ~Global("SHARTEELFIGHT","GLOBAL",2)~ repl = ~Global("S9SharteelDontBeDifficult","GLOBAL",1)~ END
		LPF s9_replace STR_VAR find = ~Global("SHARTEELFIGHT","GLOBAL",1)~ repl = ~Global("S9SharteelDontBeDifficult","GLOBAL",1)~ END
		END
	BUT_ONLY_IF_IT_CHANGES
	
